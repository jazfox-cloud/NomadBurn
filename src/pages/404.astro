---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | NomadBurn"
  description="The NomadBurn page you requested could not be found."
  canonicalPath="/404/"
  robots="noindex, follow"
>
  <section class="content-hero">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="subtitle">
      This address does not match a NomadBurn calculator, city guide, or decision page.
    </p>
    <div class="hero-actions">
      <a class="text-button" href="/">Return to the calculator</a>
      <a class="ghost-button" href="/cities/">Browse city guides</a>
    </div>
  </section>
</BaseLayout>
